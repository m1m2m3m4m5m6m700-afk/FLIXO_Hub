{
  "name": "@flixo/agent-watchdog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:security": "node scripts/security-sweep.mjs",
    "test:contracts": "node --test --experimental-strip-types test/contract.test.ts",
    "test:wrangler": "node scripts/validate-wrangler.mjs",
    "wrangler:dry-run": "wrangler deploy --dry-run --config wrangler.toml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "@types/node": "26.6.4",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
