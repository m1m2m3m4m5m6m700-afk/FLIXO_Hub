{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flixoai",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/__flixo-identity.txt",
      "/__flixo-identity-*",
      "/__flixo/*"
    ]
  },
  "env": {
    "preview": {
      "name": "flixoai-preview",
      "vars": {
        "FLIXO_ENV": "preview"
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/*"
        ]
      }
    }
  }
}
