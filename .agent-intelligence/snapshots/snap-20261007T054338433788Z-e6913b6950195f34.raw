tent\":\"https://owasp.org/images/og/owasp-default.png\"}],[\"$\",\"meta\",\"24\",{\"name\":\"twitter:image:alt\",\"content\":\"OWASP Foundation — the open source foundation for application security\"}],[\"$\",\"meta\",\"25\",{\"name\":\"twitter:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"26\",{\"name\":\"twitter:image:height\",\"content\":\"630\"}],[\"$\",\"link\",\"27\",{\"rel\":\"icon\",\"href\":\"/images/logos/favicon-owasp.svg\"}],[\"$\",\"link\",\"28\",{\"rel\":\"apple-touch-icon\",\"href\":\"/images/logos/favicon-owasp.svg\"}],[\"$\",\"$L13\",\"29\",{}]]\n14:I[755907,[\"/_next/static/immutable/chunks/33rna6oi0iw3t.js\",\"/_next/static/immutable/chunks/107_ofu64faf1.js\",\"/_next/static/immutable/chunks/1um69cr59sqou.js\",\"/_next/static/immutable/chunks/1qexsuqajd1vw.js\",\"/_next/static/immutable/chunks/0hu0acat6exoy.js\",\"/_next/static/immutable/chunks/3l06ij35lllwz.js\",\"/_next/static/immutable/chunks/276yuit2zvrqc.js\",\"/_next/static/immutable/chunks/1dam2vhxgxy6y.js\",\"/_next/static/immutable/chunks/2nbor3_yt_kfw.js\",\"/_next/static/immutable/chunks/2n9ym2old4g19.js\"],\"default\"]\n15:T591,\u003cp class=\"leading-relaxed\"\u003eThe most current released version is the \u003ca target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-[#003594] underline\" href=\"https://owasp.org/Top10/2025/\"\u003eOWASP Top 10 2025\u003c/a\u003e.\u003c/p\u003e\u003cp class=\"leading-relaxed\"\u003ePrevious versions are available at \u003ca target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-[#003594] underline\" href=\"https://owasp.org/Top10/2021/\"\u003eOWASP Top 10 2021\u003c/a\u003e and \u003ca target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-[#003594] underline\" href=\"https://owasp.org/www-pdf-archive/OWASP_Top_10-2017_%28en%29.pdf.pdf\"\u003eOWASP Top 10 2017 (PDF)\u003c/a\u003e. Older versions are available in the \u003ca target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-[#003594] underline\" href=\"https://github.com/OWASP/Top10\"\u003eGitHub repo\u003c/a\u003e.\u003c/p\u003e\u003cp class=\"leading-relaxed\"\u003eThe OWASP Top 10 is a standard awareness document for developers and web application security. It represents a broad consensus about the most critical security risks to web applications.\u003c/p\u003e\u003cp class=\"leading-relaxed\"\u003eGlobally recognized by developers as the first step towards more secure coding.\u003c/p\u003e\u003cp class=\"leading-relaxed\"\u003eCompanies should adopt this document and start the process of ensuring that their web applications minimize these risks. Using the OWASP Top 10 is perhaps the most effective first step towards changing the software development culture within your organization into one that produces more secure code.\u003c/p\u003e16:T630,[{\"title\": \"\", \"buttons\": [], \"content\": \"\u003cp class=\"\\\u0026quot;leading-relaxed\\\u0026quot;\"\u003eThe most current released version is the \u003ca target=\"_blank\" rel=\"noopener noreferrer\" class=\"\\\u0026quot;text-[#003594]\" href=\"\\\u0026quot;https://owasp.org/Top10/2025/\\\u0026quot;\"\u003eOWASP Top 10 2025\u003c/a\u003e.\u003c/p\u003e\u003cp class=\"\\\u0026quot;leading-relaxed\\\u0026quot;\"\u003ePrevious versions are available at \u003ca target=\"_blank\" rel=\"noopener noreferrer\" class=\"\\\u0026quot;text-[#003594]\" href=\"\\\u0026quot;https://owasp.org/Top10/2021/\\\u0026quot;\"\u003eOWASP Top 10 2021\u003c/a\u003e and \u003ca target=\"_blank\" rel=\"noopener noreferrer\" class=\"\\\u0026quot;text-[#003594]\" href=\"\\\u0026quot;https://owasp.org/www-pdf-archive/OWASP_Top_10-2017_%28en%29.pdf.pdf\\\u0026quot;\"\u003eOWASP Top 10 2017 (PDF)\u003c/a\u003e. Older versions are available in the \u003ca target=\"_blank\" rel=\"noopener noreferrer\" class=\"\\\u0026quot;text-[#003594]\" href=\"\\\u0026quot;https://github.com/OWASP/Top10\\\u0026quot;\"\u003eGitHub repo\u003c/a\u003e.\u003c/p\u003e\u003cp class=\"\\\u0026quot;leading-relaxed\\\u0026quot;\"\u003eThe OWASP Top 10 is a standard awareness document for developers and web application security. It represents a broad consensus about the most critical security risks to web applications.\u003c/p\u003e\u003cp class=\"\\\u0026quot;leading-relaxed\\\u0026quot;\"\u003eGlobally recognized by developers as the first step towards more secure coding.\u003c/p\u003e\u003cp class=\"\\\u0026quot;leading-relaxed\\\u0026quot;\"\u003eCompanies should adopt this document and start the process of ensuring that their web applications minimize these risks. Using the OWASP Top 10 is perhaps the most effective first step towards changing the software development culture within your organization into one that produces more secure code.\u003c/p\u003e\"}]17:T5b5,\u003cp class=\"leading-relaxed\"\u003eThe most current released version is the \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" class=\"text-[#003594] underline\" href=\"https://owasp.org/Top10/2025/\"\u003eOWASP Top 10 2025\u003c/a\u003e.\u003c/p\u003e\u003cp class=\"leading-relaxed\"\u003ePrevious versions are available at \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" class=\"text-[#003594] underline\" href=\"https://owasp.org/Top10/2021/\"\u003eOWASP Top 10 2021\u003c/a\u003e and \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" class=\"text-[#003594] underline\" href=\"https://owasp.org/www-pdf-archive/OWASP_Top_10-2017_%28en%29.pdf.pdf\"\u003eOWASP Top 10 2017 (PDF)\u003c/a\u003e. Older versions are available in the \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" class=\"text-[#003594] underline\" href=\"https://github.com/OWASP/Top10\"\u003eGitHub repo\u003c/a\u003e.\u003c/p\u003e\u003cp class=\"leading-relaxed\"\u003eThe OWASP Top 10 is a standard awareness document for developers and web application security. It represents a broad consensus about the most critical security risks to web applications.\u003c/p\u003e\u003cp class=\"leading-relaxed\"\u003eGlobally recognized by developers as the first step towards more secure coding.\u003c/p\u003e\u003cp class=\"leading-relaxed\"\u003eCompanies should adopt this document and start the process of ensuring that their web applications minimize these risks. Using the OWASP Top 10 is perhaps the most effective first step towards changing the software development culture within your organization into one that produces more secure code.\u003c/p\u003e18:T1406,[{\"links\": [], \"title\": \"Goals\", \"content\": \"To collect the most comprehensive dataset related to identified application vulnerabilities to-date to enable analysis for the Top 10 and other future research as well. This data should come from a variety of sources; security vendors and consultancies, bug bounties, along with company/organizational contributions. Data will be normalized to allow for level comparison between Human assisted Tooling and Tooling assisted Humans.\"}, {\"links\": [], \"title\": \"Analysis Infrastructure\", \"content\": \"Plan to leverage the OWASP Azure Cloud Infrastructure to collect, analyze, and store the data contributed.\"}, {\"links\": [], \"title\": \"Contributions\", \"content\": \"We plan to support both known and pseudo-anonymous contributions. The preference is for contributions to be known; this immensely helps with the validation/quality/confidence of the data submitted. If the submitter prefers to have their data stored anonymously and even go as far as submitting the data anonymously, then it will have to be classified as “unverified” vs. “verified”.\"}, {\"links\": [], \"title\": \"Verified Data Contribution\", \"content\": \"Scenario 1: The submitter is known and has agreed to be identified as a contributing party.\\n\\nScenario 2: The submitter is known but would rather not be publicly identified.\\n\\nScenario 3: The submitter is known but does not want it recorded in the dataset.\"}, {\"links\": [], \"title\": \"Unverified Data Contribution\", \"content\": \"Scenario 4: The submitter is anonymous.  (Should we support?)\\n\\nThe analysis of the data will be conducted with a careful distinction when the unverified data is part of the dataset that was analyzed.\"}, {\"links\": [{\"url\": \"https://github.com/OWASP/Top10/tree/master/2025/Data\", \"label\": \"https://github.com/OWASP/Top10/tree/master/2025/Data\"}], \"title\": \"Contribution Process\", \"content\": \"There are a few ways that data can be contributed:\\n\\nTemplate examples can be found in GitHub: https://github.com/OWASP/Top10/tree/master/2025/Data\"}, {\"links\": [], \"title\": \"Contribution Period\", \"content\": \"We plan to accept contributions to the new Top 10 until July 31, 2025, for data dating from 2021 to 2024.\"}, {\"links\": [], \"title\": \"Data Structure\", \"content\": \"The following data elements are required or optional. \\n\\nThe more information provided the more accurate our analysis can be.\\n\\nAt a bare minimum, we need the time period, total number of applications tested in the dataset, and the list of CWEs and counts of how many applications contained that CWE.\\n\\nIf at all possible, please provide the additional metadata, because that will greatly help us gain more insights into the current state of testing and vulnerabilities.\"}, {\"links\": [], \"title\": \"CWE Data\", \"content\": \"If at all possible, please provide core CWEs in the data, not CWE categories.\\n\\nThis will help with the analysis, any normalization/aggregation done as a part of this analysis will be well documented.\"}, {\"links\": [], \"title\": \"Note:\", \"content\": \"If a contributor has two types of datasets, one from HaT and one from TaH sources, then it is recommended to submit them as two separate datasets.\\n\\nHaT = Human assisted Tools (higher volume/frequency, primarily from tooling)\\n\\nTaH = Tool assisted Human (lower volume/frequency, primarily from human testing)\"}, {\"links\": [], \"title\": \"Survey\", \"content\": \"Similarly to the Top Ten 2021, we plan to conduct a survey to identify up to two categories of the Top Ten that the community believes are important, but may not be reflected in the data yet. We plan to conduct the survey in early 2025, and will be utilizing Google forms in a similar manner as last time. The CWEs on the survey will come from current trending findings, CWEs that are outside the Top Ten in data, and other potential sources.\"}, {\"links\": [], \"title\": \"Process\", \"content\": \"At a high level, we plan to perform a level of data normalization; however, we will keep a version of the raw data contributed for future analysis. We will analyze the CWE distribution of the datasets and potentially reclassify some CWEs to consolidate them into larger buckets. We will carefully document all normalization actions taken so it is clear what has been done.\\n\\nWe plan to calculate likelihood following the model we continued in 2021 to determine incidence rate instead of frequency to rate how likely a given app may contain at least one instance of a CWE. This means we aren’t looking for the frequency rate (number of findings) in an app, rather, we are looking for the number of applications that had one or more instances of a CWE. We can calculate the incidence rate based on the total number of applications tested in the dataset compared to how many applications each CWE was found in.\\n\\nIn addition, we will be developing base CWSS scores for the top 20-30 CWEs and include potential impact into the Top 10 weighting.\\n\\nAlso, would like to explore additional insights that could be gleaned from the contributed dataset to see what else can be learned that could be of use to the security and development communities.\"}]19:T4d6,At a high level, we plan to perform a level of data normalization; however, we will keep a version of the raw data contributed for future analysis. We will analyze the CWE distribution of the datasets and potentially reclassify some CWEs to consolidate them into larger buckets. We will carefully document all normalization actions taken so it is clear what has been done.\n\nWe plan to calculate likelihood following the model we continued in 2021 to determine incidence rate instead of frequency to rate how likely a given app may contain at least one instance of a CWE. This means we aren’t looking for the frequency rate (number of findings) in an app, rather, we are looking for the number of applications that had one or more instances of a CWE. We can calculate the incidence rate based on the total number of applications tested in the dataset compared to how many applications each CWE was found in.\n\nIn addition, we will be developing base CWSS scores for the top 20-30 CWEs and include potential impact into the Top 10 weighting.\n\nAlso, would like to explore additional insights that could be gleaned from the contributed dataset to see what else can be learned that could be of use to the security and development communities.9:[\"$\",\"$L14\",null,{\"project\":{\"id\":\"e6d528ca-f37c-4785-b7f0-2637f05469b7\",\"created_at\":\"2025-10-28T00:53:42.853956+00:00\",\"updated_at\":\"2026-02-10T03:02:09.317+00:00\",\"title\":\"OWASP Top 10\",\"slug\":\"top-ten\",\"description\":\"The OWASP Top 10 is the reference standard for the most critical web application security risks. Adopting the OWASP Top 10 is perhaps the most effective first step towards changing your software development culture focused on producing secure code.\",\"long_description\":null,\"image\":\"https://remssssfmrgmyzqnpeas.supabase.co/storage/v1/object/sign/project-media/projects/e6d528ca-f37c-4785-b7f0-2637f05469b7/hero/1774113493196-shkf8j5jv3.png?token=eyJraWQiOiJzdG9yYWdlLXVybC1zaWduaW5nLWtleV9iMGY5N2MxOS0wMzYwLTQ3MTMtYjliYS04Y2RhZjA0YjZjZDUiLCJhbGciOiJIUzI1NiJ9.eyJ1cmwiOiJwcm9qZWN0LW1lZGlhL3Byb2plY3RzL2U2ZDUyOGNhLWYzN2MtNDc4NS1iN2YwLTI2MzdmMDU0NjliNy9oZXJvLzE3NzQxMTM0OTMxOTYtc2hrZjhqNWp2My5wbmciLCJpYXQiOjE3NzQxMTM0OTQsImV4cCI6MTgwNTY0OTQ5NH0.faeJspe03-97KtaJcgVfQJynsu6p_qK6qXiZmJ_q8IY\",\"category\":\"Documentation\",\"status\":\"active\",\"project_url\":\"https://owasp.org/www-project-top-ten/\",\"github_url\":\"https://github.com/OWASP/Top10/\",\"is_featured\":true,\"project_type\":\"flagship\",\"website_url\":null,\"documentation_url\":\"https://owasp.org/Top10/2025/\",\"language\":\"HTML\",\"difficulty_level\":\"intermediate\",\"license\":null,\"version\":\"2025\",\"downloads\":null,\"contributors\":199,\"features\":null,\"requirements\":[],\"getting_started\":null,\"tags\":null,\"maintainers\":null,\"github_stars\":6232,\"last_updated\":null,\"tab_main_content\":null,\"tab_translation_content\":null,\"tab_sponsors_content\":null,\"tab_data_content\":null,\"project_links\":[{\"url\":\" https://owasp.org/Top10/2025/\",\"title\":\"OWASP Top 10:2025\"},{\"url\":\"https://www.owasptopten.org/\",\"title\":\"Making of OWASP Top 10\"},{\"url\":\"https://owasp.org/Top10/2021/\",\"title\":\"Previous Version (2021)\"},{\"url\":\"https://owasp.org/www-project-top-ten/2017\",\"title\":\"Previous Version (2017)\"},{\"url\":\"https://owasp.org/www-pdf-archive/OWASP_Top_10-2017_%28en%29.pdf.pdf\",\"title\":\"OWASP Top 10 2017 PDF\"}],\"project_leaders\":[{\"name\":\"Brian Glas\",\"role\":\"\",\"social\":\"\",\"contact\":\"brian.glas@owasp.org\",\"leader_type\":\"leader\"},{\"name\":\"Neil Smithline\",\"role\":\"\",\"social\":\"\",\"contact\":\"neil.smithline@owasp.org\",\"leader_type\":\"leader\"},{\"name\":\"Tanya Janca\",\"role\":\"\",\"social\":\"\",\"contact\":\"tanya.janca@owasp.org\",\"leader_type\":\"leader\"},{\"name\":\"Torsten Gigler\",\"role\":\"\",\"social\":\"\",\"contact\":\"torsten.gigler@owasp.org\",\"leader_type\":\"leader\"},{\"name\":\"Andrew van der Stock\",\"role\":\"Project Leader\",\"contact\":\"vanderaj@owasp.org\",\"leader_type\":\"leader\"}],\"social_links\":[],\"project_overview\":\"$15\",\"key_features\":null,\"installation_guide\":null,\"usage_examples\":null,\"api_documentation\":null,\"security_considerations\":null,\"best_practices\":null,\"troubleshooting\":null,\"changelog\":null,\"roadmap\":null,\"community_guidelines\":null,\"contribution_guide\":null,\"tab_overview_content\":null,\"tab_documentation_content\":null,\"tab_downloads_content\":null,\"tab_community_content\":null,\"tab_contribute_content\":null,\"tab_support_content\":null,\"screenshots\":null,\"videos\":null,\"tutorials\":null,\"case_studies\":null,\"integrations\":null,\"third_party_tools\":null,\"download_count\":0,\"active_installations\":0,\"security_advisories\":null,\"release_notes\":null,\"meta_title\":null,\"meta_description\":null,\"meta_keywords\":null,\"canonical_url\":null,\"related_projects\":[],\"dependencies\":null,\"dependents\":null,\"industry_usage\":[],\"compliance_standards\":[],\"threat_categories\":null,\"content_version\":\"1.0\",\"content_last_updated\":\"2025-10-28T00:53:42.853956+00:00\",\"content_reviewer\":null,\"content_status\":\"published\",\"tabs\":[{\"id\":\"tab_1787641775004\",\"name\":\"About the OWASP Top 10\",\"order\":1,\"content\":\"$16\",\"sections\":[{\"title\":\"\",\"buttons\":[],\"content\":\"$17\"}]},{\"id\":\"tab-1770692529316-wkwk3tayi\",\"name\":\"Translation Efforts\",\"order\":2,\"content\":\"[{\\\"links\\\": [{\\\"url\\\": \\\"https://github.com/OWASP/Top10/issues?utf8=%E2%9C%93\u0026amp;q=is%3Aissue\\\", \\\"label\\\": \\\"github\\\"}, {\\\"url\\\": \\\"https://owasp.org/cdn-cgi/l/email-protection\\\", \\\"label\\\": \\\"[email protected]\\\"}], \\\"title\\\": \\\"Translation Efforts\\\", \\\"content\\\": \\\"Efforts have been made in numerous languages to translate the OWASP Top 10 - 2025. If you are interested in helping, please contact the members of the team for the language you are interested in contributing to, or if you don’t see your language listed (neither here nor at github), please email [email protected] to let us know that you want to help and we’ll form a volunteer group for your language.\\\"}, {\\\"links\\\": [], \\\"title\\\": \\\"Top10:2025 Completed Translations:\\\", \\\"content\\\": \\\"Translations in progress - check back soon!\\\"}]\",\"sections\":[{\"links\":[{\"url\":\"https://github.com/OWASP/Top10/issues?utf8=%E2%9C%93\u0026q=is%3Aissue\",\"label\":\"github\"},{\"url\":\"https://owasp.org/cdn-cgi/l/email-protection\",\"label\":\"[email protected]\"}],\"title\":\"Translation Efforts\",\"content\":\"Efforts have been made in numerous languages to translate the OWASP Top 10 - 2025. If you are interested in helping, please contact the members of the team for the language you are interested in contributing to, or if you don’t see your language listed (neither here nor at github), please email [email protected] to let us know that you want to help and we’ll form a volunteer group for your language.\"},{\"links\":[],\"title\":\"Top10:2025 Completed Translations:\",\"content\":\"Translations in progress - check back soon!\"}]},{\"id\":\"tab-1770692529316-g45fr7ysk\",\"name\":\"Sponsors\",\"order\":3,\"content\":\"[{\\\"links\\\": [], \\\"title\\\": \\\"2021 Project Sponsors\\\", \\\"content\\\": \\\"The OWASP Top 10:2021 is sponsored by Secure Code Warrior.\\\"}, {\\\"links\\\": [{\\\"url\\\": \\\"https://owasp.org/www-chapter-northern-virginia/\\\", \\\"label\\\": \\\"OWASP NoVA Chapter\\\"}], \\\"title\\\": \\\"2017 Project Sponsors\\\", \\\"content\\\": \\\"The OWASP Top 10 - 2017 project was sponsored by Autodesk, and supported by the OWASP NoVA Chapter.\\\"}, {\\\"links\\\": [{\\\"url\\\": \\\"https://www.aspectsecurity.com/\\\", \\\"label\\\": \\\"Aspect Security\\\"}], \\\"title\\\": \\\"2003-2013 Project Sponsors\\\", \\\"content\\\": \\\"Thanks to Aspect Security for sponsoring earlier versions.\\\"}]\",\"sections\":[{\"links\":[],\"title\":\"2021 Project Sponsors\",\"content\":\"The OWASP Top 10:2021 is sponsored by Secure Code Warrior.\"},{\"links\":[{\"url\":\"https://owasp.org/www-chapter-northern-virginia/\",\"label\":\"OWASP NoVA Chapter\"}],\"title\":\"2017 Project Sponsors\",\"content\":\"The OWASP Top 10 - 2017 project was sponsored by Autodesk, and supported by the OWASP NoVA Chapter.\"},{\"links\":[{\"url\":\"https://www.aspectsecurity.com/\",\"label\":\"Aspect Security\"}],\"title\":\"2003-2013 Project Sponsors\",\"content\":\"Thanks to Aspect Security for sponsoring earlier versions.\"}]},{\"id\":\"tab-1770692529317-36f6k119a\",\"name\":\"Data 2025\",\"order\":4,\"content\":\"$18\",\"sections\":[{\"links\":[],\"title\":\"Goals\",\"content\":\"To collect the most comprehensive dataset related to identified application vulnerabilities to-date to enable analysis for the Top 10 and other future research as well. This data should come from a variety of sources; security vendors and consultancies, bug bounties, along with company/organizational contributions. Data will be normalized to allow for level comparison between Human assisted Tooling and Tooling assisted Humans.\"},{\"links\":[],\"title\":\"Analysis Infrastructure\",\"content\":\"Plan to leverage the OWASP Azure Cloud Infrastructure to collect, analyze, and store the data contributed.\"},{\"links\":[],\"title\":\"Contributions\",\"content\":\"We plan to support both known and pseudo-anonymous contributions. The preference is for contributions to be known; this immensely helps with the validation/quality/confidence of the data submitted. If the submitter prefers to have their data stored anonymously and even go as far as submitting the data anonymously, then it will have to be classified as “unverified” vs. “verified”.\"},{\"links\":[],\"title\":\"Verified Data Contribution\",\"content\":\"Scenario 1: The submitter is known and has agreed to be identified as a contributing party.\\n\\nScenario 2: The submitter is known but would rather not be publicly identified.\\n\\nScenario 3: The submitter is known but does not want it recorded in the dataset.\"},{\"links\":[],\"title\":\"Unverified Data Contribution\",\"content\":\"Scenario 4: The submitter is anonymous.  (Should we support?)\\n\\nThe analysis of the data will be conducted with a careful distinction when the unverified data is part of the dataset that was analyzed.\"},{\"links\":[{\"url\":\"https://github.com/OWASP/Top10/tree/master/2025/Data\",\"label\":\"https://github.com/OWASP/Top10/tree/master/2025/Data\"}],\"title\":\"Contribution Process\",\"content\":\"There are a few ways that data can be contributed:\\n\\nTemplate examples can be found in GitHub: https://github.com/OWASP/Top10/tree/master/2025/Data\"},{\"links\":[],\"title\":\"Contribution Period\",\"content\":\"We plan to accept contributions to the new Top 10 until July 31, 2025, for data dating from 2021 to 2024.\"},{\"links\":[],\"title\":\"Data Structure\",\"content\":\"The following data elements are required or optional. \\n\\nThe more information provided the more accurate our analysis can be.\\n\\nAt a bare minimum, we need the time period, total number of applications tested in the dataset, and the list of CWEs and counts of how many applications contained that CWE.\\n\\nIf at all possible, please provide the additional metadata, because that will greatly help us gain more insights into the current state of testing and vulnerabilities.\"},{\"links\":[],\"title\":\"CWE Data\",\"content\":\"If at all possible, please provide core CWEs in the data, not CWE categories.\\n\\nThis will help with the analysis, any normalization/aggregation done as a part of this analysis will be well documented.\"},{\"links\":[],\"title\":\"Note:\",\"content\":\"If a contributor has two types of datasets, one from HaT and one from TaH sources, then it is recommended to submit them as two separate datasets.\\n\\nHaT = Human assisted Tools (higher volume/frequency, primarily from tooling)\\n\\nTaH = Tool assisted Human (lower volume/frequency, primarily from human testing)\"},{\"links\":[],\"title\":\"Survey\",\"content\":\"Similarly to the Top Ten 2021, we plan to conduct a survey to identify up to two categories of the Top Ten that the community believes are important, but may not be reflected in the data yet. We plan to conduct the survey in early 2025, and will be utilizing Google forms in a similar manner as last time. The CWEs on the survey will come from current trending findings, CWEs that are outside the Top Ten in data, and other potential sources.\"},{\"links\":[],\"title\":\"Process\",\"content\":\"$19\"}]}],\"hero_video_url\":null,\"hero_image\":null,\"hero_gif_url\":null,\"hero_highlights\":[],\"overview_sections\":[],\"hero_buttons\":[],\"overview_cards\":[{\"id\":\"card-1774113985973\",\"type\":\"links\",\"items\":[{\"url\":\"https://twitter.com/owasptop10\",\"title\":\"Link\"}],\"title\":\"Social\"}],\"deleted_at\":null,\"github_downloads\":0,\"github_synced_at\":\"2026-10-06T21:41:00.494+00:00\",\"github_sync_status\":\"ok\",\"github_sync_error\":null,\"related_project_links\":[]}}]\n"])</script></body></html>