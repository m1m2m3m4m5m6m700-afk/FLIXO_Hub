<script defer="" id="awsc-panorama-bundle" type="text/javascript" src="https://prod.pa.cdn.uis.awsstatic.com/panorama-nav-init.js" data-config="{'appEntity':'aws-documentation','region':'us-east-1','service':'prescriptive-guidance'}"></script><meta id="panorama-serviceSubSection" value="Building hexagonal architectures on AWS" /><meta id="panorama-serviceConsolePage" value="Overview" /></head><body class="awsdocs awsui"><div class="awsdocs-container"><p><a href="overview.md">View a markdown version of this page</a></p><awsdocs-header></awsdocs-header><awsui-app-layout id="app-layout" class="awsui-util-no-gutters" ng-controller="ContentController as $ctrl" header-selector="awsdocs-header" navigation-hide="false" navigation-width="$ctrl.navWidth" navigation-open="$ctrl.navOpen" navigation-change="$ctrl.onNavChange($event)" tools-hide="$ctrl.hideTools" tools-width="$ctrl.toolsWidth" tools-open="$ctrl.toolsOpen" tools-change="$ctrl.onToolsChange($event)"><div id="guide-toc" dom-region="navigation"><awsdocs-toc></awsdocs-toc></div><div id="main-column" dom-region="content" tabindex="-1"><awsdocs-view class="awsdocs-view"><div id="awsdocs-content"><head><title>Overview - AWS Prescriptive Guidance</title><meta name="pdf" content="/pdfs/prescriptive-guidance/latest/hexagonal-architectures/hexagonal-architectures.pdf#overview" /><meta name="forums" content="https://repost.aws/" /><meta name="feedback" content="https://docs.aws.amazon.com/forms/aws-doc-feedback?hidden_service_name=ProServe%20Enterprise%20GPS&amp;topic_url=https://docs.aws.amazon.com/en_us/prescriptive-guidance/latest/hexagonal-architectures/overview.html" /><meta name="feedback-yes" content="feedbackyes.html?topic_url=https://docs.aws.amazon.com/en_us/prescriptive-guidance/latest/hexagonal-architectures/overview.html" /><meta name="feedback-no" content="feedbackno.html?topic_url=https://docs.aws.amazon.com/en_us/prescriptive-guidance/latest/hexagonal-architectures/overview.html" /><meta name="keywords" content="AWS prescriptive guidance,WebsitesAndWebApps,ContainersAndMicroservices,DevOps,Modernization,Serverless,ApiGateway,DynamoDB,Lambda,SQS,ElasticContainerService" /><link rel="alternate" type="text/markdown" href="overview.md" title="Markdown version" /><script type="application/ld+json">
{
    "@context" : "https://schema.org",
